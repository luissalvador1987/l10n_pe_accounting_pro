<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_plame_worker_list" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.plame.worker.list</field>
        <field name="model">l10n_pe_accounting.plame.worker</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="dni"/>
                <field name="name"/>
                <field name="worker_type"/>
                <field name="pension_regime"/>
                <field name="afp_cuspp"/>
                <field name="position"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_plame_worker" model="ir.actions.act_window">
        <field name="name">Trabajadores (Censo PLAME)</field>
        <field name="res_model">l10n_pe_accounting.plame.worker</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_plame_period_form" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.plame.period.form</field>
        <field name="model">l10n_pe_accounting.plame.period</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(l10n_pe_accounting_pro.action_plame_export_wizard)d" type="action"
                            string="Exportar TXT" class="oe_highlight"
                            context="{'default_period_id': id}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="period" placeholder="202601"/>
                        </group>
                        <group>
                            <field name="total_gross"/>
                            <field name="total_essalud"/>
                            <field name="total_net"/>
                        </group>
                    </group>
                    <button name="action_load_active_workers" type="object"
                            string="Cargar trabajadores activos" class="btn-secondary"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="worker_id"/>
                            <field name="basic_remuneration"/>
                            <field name="bonuses"/>
                            <field name="overtime"/>
                            <field name="gross_income"/>
                            <field name="essalud_rate"/>
                            <field name="essalud_contribution"/>
                            <field name="pension_rate"/>
                            <field name="pension_contribution"/>
                            <field name="income_tax_retention"/>
                            <field name="net_pay"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_plame_period_list" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.plame.period.list</field>
        <field name="model">l10n_pe_accounting.plame.period</field>
        <field name="arch" type="xml">
            <list>
                <field name="period"/>
                <field name="total_gross"/>
                <field name="total_essalud"/>
                <field name="total_net"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_plame_period" model="ir.actions.act_window">
        <field name="name">Periodos PLAME/T-Registro</field>
        <field name="res_model">l10n_pe_accounting.plame.period</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
