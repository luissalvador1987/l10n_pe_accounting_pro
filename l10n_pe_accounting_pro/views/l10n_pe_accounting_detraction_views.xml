<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_detraction_list" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.detraction.list</field>
        <field name="model">l10n_pe_accounting.detraction</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'deposited'">
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="category_id"/>
                <field name="base_amount"/>
                <field name="detraction_amount"/>
                <field name="state" widget="badge" decoration-success="state == 'deposited'"/>
                <field name="constancia_number"/>
            </list>
        </field>
    </record>

    <record id="view_detraction_form" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.detraction.form</field>
        <field name="model">l10n_pe_accounting.detraction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="move_id"/>
                            <field name="partner_id"/>
                            <field name="category_id"/>
                        </group>
                        <group>
                            <field name="percentage"/>
                            <field name="base_amount"/>
                            <field name="detraction_amount"/>
                            <field name="net_payable"/>
                            <field name="state" widget="badge"/>
                        </group>
                    </group>
                    <group string="Depósito" invisible="state != 'deposited'">
                        <field name="constancia_number"/>
                        <field name="constancia_date"/>
                        <field name="bank_account_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_detraction_category_list" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.detraction.category.list</field>
        <field name="model">l10n_pe_accounting.detraction.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="anexo"/>
                <field name="percentage"/>
                <field name="min_amount"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_detraction" model="ir.actions.act_window">
        <field name="name">Detracciones</field>
        <field name="res_model">l10n_pe_accounting.detraction</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_detraction_category" model="ir.actions.act_window">
        <field name="name">Categorías SPOT (Detracción)</field>
        <field name="res_model">l10n_pe_accounting.detraction.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
