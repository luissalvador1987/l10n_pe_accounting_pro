<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_l10n_pe_accounting" model="ir.ui.view">
        <field name="name">product.template.form.inherit.l10n.pe.accounting.pro</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Perú - Detracción (SPOT)">
                    <field name="l10n_pe_detraction_category_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
