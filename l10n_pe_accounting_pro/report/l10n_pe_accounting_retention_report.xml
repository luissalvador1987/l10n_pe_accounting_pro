<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_retention" model="ir.actions.report">
        <field name="name">Comprobante de Retención</field>
        <field name="model">l10n_pe_accounting.retention</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_pe_accounting_pro.report_retention_document</field>
        <field name="report_file">l10n_pe_accounting_pro.report_retention_document</field>
        <field name="binding_model_id" ref="model_l10n_pe_accounting_retention"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_retention_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Comprobante de Retención N° <span t-field="o.number"/></h2>
                        <p>Fecha: <span t-field="o.date"/></p>
                        <p>Proveedor: <span t-field="o.partner_id.name"/> -
                            <span t-field="o.partner_id.vat"/></p>
                        <table class="table table-sm">
                            <tr><td>Importe de la operación</td>
                                <td class="text-end"><span t-field="o.base_amount"/></td></tr>
                            <tr><td>Tasa</td><td class="text-end"><span t-field="o.rate"/>%</td></tr>
                            <tr class="fw-bold"><td>Monto retenido</td>
                                <td class="text-end"><span t-field="o.retention_amount"/></td></tr>
                        </table>
                        <p>Comprobante(s) afectado(s):
                            <span t-esc="', '.join(o.invoice_ids.mapped('name'))"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
