<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_list" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.asset.list</field>
        <field name="model">l10n_pe_accounting.asset</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'removed'">
                <field name="code"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="purchase_value"/>
                <field name="book_depreciated_value"/>
                <field name="value_residual"/>
                <field name="l10n_pe_temporary_difference"/>
                <field name="state" widget="badge" decoration-success="state == 'running'"/>
            </list>
        </field>
    </record>

    <record id="view_asset_form" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.asset.form</field>
        <field name="model">l10n_pe_accounting.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute_book_depreciation_board" type="object"
                            string="Calcular cronograma contable" class="oe_highlight"
                            invisible="state not in ('draft','running')"/>
                    <button name="action_remove" type="object" string="Dar de baja"
                            invisible="state in ('removed','draft')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="partner_id"/>
                            <field name="purchase_value"/>
                            <field name="salvage_value"/>
                            <field name="date_start"/>
                            <field name="useful_life_years"/>
                        </group>
                        <group>
                            <field name="account_asset_id"/>
                            <field name="account_depreciation_id"/>
                            <field name="account_expense_id"/>
                            <field name="journal_id"/>
                            <field name="book_depreciated_value" readonly="1"/>
                            <field name="value_residual" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cronograma Contable (NIIF)">
                            <field name="book_line_ids">
                                <list create="0" delete="0">
                                    <field name="line_date"/>
                                    <field name="amount"/>
                                    <field name="accumulated"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'posted'"/>
                                    <button name="action_post" type="object" string="Contabilizar"
                                            invisible="state == 'posted'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Depreciación Tributaria (SUNAT)">
                            <group>
                                <group>
                                    <field name="l10n_pe_tax_category_id"/>
                                    <field name="l10n_pe_tax_annual_rate"/>
                                    <field name="l10n_pe_tax_rate_exceeds_max" invisible="1"/>
                                    <div class="alert alert-warning" role="alert"
                                         invisible="not l10n_pe_tax_rate_exceeds_max">
                                        La tasa supera el máximo tributario de la categoría elegida: la
                                        parte en exceso será una adición (diferencia permanente) en la
                                        declaración anual de renta.
                                    </div>
                                </group>
                                <group>
                                    <field name="l10n_pe_tax_depreciated_value"/>
                                    <field name="l10n_pe_temporary_difference"/>
                                    <field name="l10n_pe_deferred_tax"/>
                                </group>
                            </group>
                            <button name="l10n_pe_compute_tax_depreciation_board" type="object"
                                    string="Calcular cronograma tributario" class="btn-secondary"/>
                            <field name="l10n_pe_tax_line_ids">
                                <list create="0" editable="bottom">
                                    <field name="year"/>
                                    <field name="months"/>
                                    <field name="amount"/>
                                    <field name="accumulated"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asset" model="ir.actions.act_window">
        <field name="name">Activos Fijos</field>
        <field name="res_model">l10n_pe_accounting.asset</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_asset_tax_category_list" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.asset.tax.category.list</field>
        <field name="model">l10n_pe_accounting.asset.tax.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="max_annual_rate"/>
                <field name="note"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_asset_tax_category" model="ir.actions.act_window">
        <field name="name">Categorías Tributarias de Depreciación</field>
        <field name="res_model">l10n_pe_accounting.asset.tax.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
