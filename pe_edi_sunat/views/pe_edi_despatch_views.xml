<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pe_edi_despatch_list" model="ir.ui.view">
        <field name="name">pe.edi.despatch.list</field>
        <field name="model">pe.edi.despatch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="issue_date"/>
                <field name="motivo_traslado"/>
                <field name="state" widget="badge" decoration-success="state == 'accepted'"
                       decoration-danger="state in ('rejected', 'error')"/>
            </list>
        </field>
    </record>

    <record id="view_pe_edi_despatch_form" model="ir.ui.view">
        <field name="name">pe.edi.despatch.form</field>
        <field name="model">pe.edi.despatch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_xml" type="object" string="Generar y firmar XML"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_send" type="object" string="Enviar a SUNAT"
                            invisible="state not in ('generated', 'error')" class="oe_highlight"/>
                    <button name="action_check_status" type="object" string="Consultar estado"
                            invisible="state != 'sent'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,generated,sent,accepted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="series"/>
                            <field name="partner_id"/>
                            <field name="picking_id"/>
                            <field name="issue_date"/>
                        </group>
                        <group>
                            <field name="motivo_traslado"/>
                            <field name="modalidad_traslado"/>
                            <field name="fecha_traslado"/>
                            <field name="peso_bruto_total"/>
                        </group>
                    </group>
                    <group string="Traslado">
                        <group>
                            <field name="punto_partida_ubigeo"/>
                            <field name="punto_partida_direccion"/>
                        </group>
                        <group>
                            <field name="punto_llegada_ubigeo"/>
                            <field name="punto_llegada_direccion"/>
                        </group>
                    </group>
                    <group string="Transporte">
                        <field name="vehiculo_placa"/>
                        <field name="conductor_numero_doc"/>
                        <field name="conductor_nombre"/>
                    </group>
                    <notebook>
                        <page string="Mercadería">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="SUNAT" invisible="not xml_file">
                            <group>
                                <field name="ticket" readonly="1"/>
                                <button name="action_l10n_pe_edi_download_xml" type="object" string="Ver XML"
                                        invisible="not xml_file" class="btn-link"/>
                                <field name="qr_image" widget="image" invisible="not qr_image" class="oe_avatar"/>
                            </group>
                            <group string="Error" invisible="not error_message">
                                <field name="error_message" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pe_edi_despatch" model="ir.actions.act_window">
        <field name="name">Guías de Remisión Electrónica</field>
        <field name="res_model">pe.edi.despatch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea tu primera Guía de Remisión</p>
        </field>
    </record>
</odoo>
