<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_detraction_register_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.detraction.register.wizard.form</field>
        <field name="model">l10n_pe_accounting.detraction.register.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="detraction_id" invisible="1"/>
                    <field name="constancia_number"/>
                    <field name="constancia_date"/>
                    <field name="bank_account_id"/>
                </group>
                <footer>
                    <button string="Confirmar" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_detraction_register_wizard" model="ir.actions.act_window">
        <field name="name">Registrar depósito de detracción</field>
        <field name="res_model">l10n_pe_accounting.detraction.register.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
