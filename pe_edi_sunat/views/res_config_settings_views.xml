<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pe.edi.sunat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Facturación Electrónica SUNAT" string="Facturación Electrónica SUNAT"
                     name="pe_edi_sunat">
                    <block title="Ambiente" name="pe_edi_environment_setting_container">
                        <setting id="pe_edi_environment_setting"
                                 help="Empieza siempre en Beta/Homologación; pasa a Producción solo cuando tengas certificado y series definitivas.">
                            <field name="l10n_pe_edi_environment"/>
                        </setting>
                        <setting id="pe_edi_trade_name_setting">
                            <field name="l10n_pe_edi_trade_name"/>
                        </setting>
                    </block>
                    <block title="Certificado digital" name="pe_edi_certificate_setting_container">
                        <setting id="pe_edi_certificate_setting">
                            <field name="l10n_pe_edi_certificate_id" options="{'no_create_edit': True}"/>
                            <div class="mt8">
                                <button name="%(action_pe_edi_certificate)d" type="action"
                                        string="Gestionar certificados" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Credenciales SOL (Factura / Boleta / Notas)" name="pe_edi_sol_setting_container">
                        <setting id="pe_edi_sol_setting"
                                 help="Usuario secundario SOL habilitado para el servicio 'Envío de comprobantes'.">
                            <field name="l10n_pe_edi_sol_user"/>
                            <field name="l10n_pe_edi_sol_password" password="True"/>
                        </setting>
                    </block>
                    <block title="Guía de Remisión Electrónica (GRE)" name="pe_edi_gre_setting_container">
                        <setting id="pe_edi_gre_setting"
                                 help="Client ID/Secret generados en SUNAT Operaciones en Línea &gt; Empresas &gt; API SUNAT.">
                            <field name="l10n_pe_edi_gre_client_id"/>
                            <field name="l10n_pe_edi_gre_client_secret" password="True"/>
                            <field name="l10n_pe_edi_gre_submission_url"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
