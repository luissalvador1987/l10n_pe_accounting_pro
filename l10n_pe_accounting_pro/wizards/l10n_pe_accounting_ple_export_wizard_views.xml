<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ple_export_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.ple.export.wizard.form</field>
        <field name="model">l10n_pe_accounting.ple.export.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="book_type"/>
                    <field name="period" placeholder="202601"/>
                </group>
                <footer>
                    <button string="Exportar TXT" type="object" name="action_export" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ple_export_wizard" model="ir.actions.act_window">
        <field name="name">Exportar PLE (Registro de Compras/Ventas)</field>
        <field name="res_model">l10n_pe_accounting.ple.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
