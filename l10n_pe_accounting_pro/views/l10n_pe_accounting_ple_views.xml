<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ple_purchase_list" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.ple.purchase.line.list</field>
        <field name="model">l10n_pe_accounting.ple.purchase.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="period"/>
                <field name="emission_date"/>
                <field name="doc_type_code"/>
                <field name="series"/>
                <field name="number"/>
                <field name="partner_name"/>
                <field name="base_taxed"/>
                <field name="igv_amount"/>
                <field name="total_amount"/>
                <field name="is_subject_to_detraction"/>
                <field name="state" widget="badge" decoration-success="state == 'exported'"/>
            </list>
        </field>
    </record>

    <record id="view_ple_sale_list" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.ple.sale.line.list</field>
        <field name="model">l10n_pe_accounting.ple.sale.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="period"/>
                <field name="emission_date"/>
                <field name="doc_type_code"/>
                <field name="series"/>
                <field name="number"/>
                <field name="partner_name"/>
                <field name="base_taxed"/>
                <field name="igv_amount"/>
                <field name="total_amount"/>
                <field name="state" widget="badge" decoration-success="state == 'exported'"/>
            </list>
        </field>
    </record>

    <record id="action_ple_purchase" model="ir.actions.act_window">
        <field name="name">Registro de Compras (PLE)</field>
        <field name="res_model">l10n_pe_accounting.ple.purchase.line</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_ple_sale" model="ir.actions.act_window">
        <field name="name">Registro de Ventas e Ingresos (PLE)</field>
        <field name="res_model">l10n_pe_accounting.ple.sale.line</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
