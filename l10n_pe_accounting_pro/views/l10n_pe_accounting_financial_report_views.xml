<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_financial_report_line_list" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.financial.report.line.list</field>
        <field name="model">l10n_pe_accounting.financial.report.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-bf="bold">
                <field name="report_type"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="level"/>
                <field name="code_prefixes"/>
                <field name="sign"/>
                <field name="balance_mode"/>
                <field name="is_total"/>
                <field name="component_line_ids" widget="many2many_tags"/>
                <field name="bold"/>
            </list>
        </field>
    </record>

    <record id="action_financial_report_line" model="ir.actions.act_window">
        <field name="name">Plantillas de Estados Financieros</field>
        <field name="res_model">l10n_pe_accounting.financial.report.line</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
