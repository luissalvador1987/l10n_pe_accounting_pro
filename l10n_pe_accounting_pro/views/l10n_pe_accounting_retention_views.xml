<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_retention_list" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.retention.list</field>
        <field name="model">l10n_pe_accounting.retention</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="number"/>
                <field name="date"/>
                <field name="direction"/>
                <field name="partner_id"/>
                <field name="retention_amount"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <record id="view_retention_form" model="ir.ui.view">
        <field name="name">l10n_pe_accounting.retention.form</field>
        <field name="model">l10n_pe_accounting.retention</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Contabilizar" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Anular"
                            invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="number" readonly="1"/>
                            <field name="direction"/>
                            <field name="date"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="invoice_ids" widget="many2many_tags"/>
                            <field name="base_amount"/>
                            <field name="rate"/>
                            <field name="retention_amount"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_retention" model="ir.actions.act_window">
        <field name="name">Retenciones de IGV</field>
        <field name="res_model">l10n_pe_accounting.retention</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
