<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.pe.edi.sunat</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="l10n_pe_edi_is_required" invisible="1"/>
                <button name="action_l10n_pe_edi_generate_and_send" type="object"
                        string="Generar y enviar a SUNAT" class="oe_highlight"
                        groups="pe_edi_sunat.group_pe_edi_user"
                        invisible="not l10n_pe_edi_is_required or state != 'posted' or l10n_pe_edi_state in ('accepted',)"/>
                <button name="action_l10n_pe_edi_send" type="object" string="Reintentar envío a SUNAT"
                        groups="pe_edi_sunat.group_pe_edi_user"
                        invisible="not l10n_pe_edi_is_required or l10n_pe_edi_state not in ('to_send', 'error', 'rejected') or not l10n_pe_edi_xml_file"/>
                <field name="l10n_pe_edi_state" widget="badge" invisible="not l10n_pe_edi_is_required"
                       decoration-success="l10n_pe_edi_state == 'accepted'"
                       decoration-danger="l10n_pe_edi_state in ('rejected', 'error')"
                       decoration-info="l10n_pe_edi_state == 'to_send'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="SUNAT" name="pe_edi_sunat" invisible="not l10n_pe_edi_is_required">
                    <group>
                        <group string="Envío">
                            <field name="l10n_pe_edi_hash" readonly="1"/>
                            <field name="l10n_pe_edi_cdr_code" readonly="1"/>
                            <field name="l10n_pe_edi_cdr_description" readonly="1"/>
                            <button name="action_l10n_pe_edi_download_xml" type="object" string="Descargar XML"
                                    invisible="not l10n_pe_edi_xml_file" class="btn-link"/>
                            <button name="action_l10n_pe_edi_download_cdr" type="object" string="Descargar CDR"
                                    invisible="not l10n_pe_edi_cdr_file" class="btn-link"/>
                        </group>
                        <group string="Código QR">
                            <field name="l10n_pe_edi_qr_image" widget="image" nolabel="1"
                                   invisible="not l10n_pe_edi_qr_image" class="oe_avatar"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not l10n_pe_edi_error_message">
                        <field name="l10n_pe_edi_error_message" nolabel="1"/>
                    </group>
                    <group string="Nota de Crédito / Débito"
                           invisible="l10n_latam_document_type_id_code not in ('07', '08')">
                        <field name="l10n_pe_edi_note_reason_code"/>
                        <field name="l10n_pe_edi_note_reason_text"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
